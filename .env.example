# Copy to .env for local runs. GitHub Actions uses repository secrets with the same names.

# Comma-separated backends tried in order. Later backends run only if the
# previous one is blocked (403/429/503, captcha, or missing sentinel).
FETCH_BACKENDS=direct,scraperapi,zenrows

# Optional scraping APIs — leave empty to skip that backend.
SCRAPERAPI_KEY=
ZENROWS_API_KEY=

# telegram, discord, or both. Missing credentials log a warning instead of crashing.
NOTIFY_CHANNELS=telegram,discord
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Alert thresholds
MIN_DROP_ABS=2000
MIN_DROP_PCT=0.03
ALERT_COOLDOWN_HOURS=24
FAILURE_ALERT_THRESHOLD=3

# Price sanity band (rejects carousel / parse errors)
PRICE_MIN=50000
PRICE_MAX=400000

# Delay between products (seconds)
DELAY_MIN=3
DELAY_MAX=8
